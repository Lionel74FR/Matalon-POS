{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @matalon/caisse build",
  "outputDirectory": "apps/caisse/dist",
  "rewrites": [{ "source": "/((?!assets/|sw.js|workbox-|manifest.webmanifest|icone).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
